#!/bin/bash
## Load slug from Bind Mount, Artifacts dir or URL

set -eo pipefail

## Load profile.d, profile and release config

shopt -s nullglob
mkdir -p .profile.d
if [[ -s .release ]]; then
  # Parse config_vars from .release YAML (simple key: value format)
  in_config=false
  while IFS= read -r line; do
    if echo "$line" | grep -qE '^config_vars:'; then
      in_config=true
      continue
    fi
    if [[ "$in_config" == true ]]; then
      if echo "$line" | grep -qE '^  [a-zA-Z_][a-zA-Z0-9_]*:'; then
        key=$(echo "$line" | sed 's/^  \([a-zA-Z_][a-zA-Z0-9_]*\):.*/\1/')
        val=$(echo "$line" | sed "s/^  [a-zA-Z_][a-zA-Z0-9_]*: *//; s/^['\"]//; s/['\"]$//")
        echo "${key}=\${${key}:-'${val}'}"
      else
        break
      fi
    fi
  done < .release > .profile.d/config_vars
fi
for file in .profile.d/*; do
  source "${file}"
done
if [[ -f .profile  ]]; then
  source .profile
fi
hash -r

## Inject "start" command to run processes defined in Procfile

case "$1" in
  start)
    if [[ -f Procfile ]]; then
      command=$(grep -E "^$2:" Procfile | sed "s/^$2: *//" | head -1)
    else
      # Parse default_process_types from .release
      in_dpt=false
      while IFS= read -r line; do
        if echo "$line" | grep -qE '^default_process_types:'; then
          in_dpt=true
          continue
        fi
        if [[ "$in_dpt" == true ]]; then
          if echo "$line" | grep -qE "^  $2:"; then
            command=$(echo "$line" | sed "s/^  $2: *//")
            break
          elif ! echo "$line" | grep -qE '^  '; then
            break
          fi
        fi
      done < .release
    fi
    ;;
  *)
    printf -v command " %q" "$@"
    ;;
esac

## Run!

exec bash -c "${command}"
